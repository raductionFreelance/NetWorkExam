<Window x:Class="MessengerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger"
        Height="600"
        Width="1000">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Учасники в групі"
                  Grid.Column="0"
                  Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Margin="5" Height="25" x:Name="chatNameTextBox" IsReadOnly="True" Background="#F0F0F0"/>
                <ListBox Grid.Row="1" Margin="5" x:Name="chatList"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Повідомлення"
                  Grid.Column="1"
                  Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="5" FontWeight="Bold" Text="Чат: Загальний чат" x:Name="chatNameTextBlock"/>
                <ListBox Grid.Row="1" Margin="5" x:Name="messageList"/>

                <Grid Grid.Row="2" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="25" Margin="0,0,5,0" x:Name="messageTextBox" KeyDown="messageTextBox_KeyDown"/>
                    <Button Grid.Column="1" Content="Надіслати" Click="SendMessage_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="Контактна книга"
                  Grid.Column="2"
                  Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="5">
                    <TextBlock Text="Користувач: " x:Name="userNameTextBlock"/>
                    <TextBlock Text="Статус: " x:Name="userStatusTextBlock"/>
                </StackPanel>

                <ListBox Grid.Row="1" Margin="5" x:Name="userList"/>

                <StackPanel Grid.Row="2" Margin="5">
                    <Button Content="Додати чат/групу" Margin="0,0,0,5" Click="AddChatButton_Click"/>
                    <Button Content="Видалити чат/групу" Margin="0,0,0,5" Click="DeleteChatRoomButton_Click"/>
                    <Separator Margin="0,2,0,5"/>
                    <Button Content="Додати учасника в групу" Margin="0,0,0,5" Click="AddUserToChat_Click"/>
                    <Button Content="Видалити учасника з групи" Margin="0,0,0,5" Click="RemoveUserFromChat_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>